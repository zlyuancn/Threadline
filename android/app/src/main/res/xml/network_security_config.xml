<?xml version="1.0" encoding="utf-8"?>
<!--
  明文只对回环放行：转发的入口永远在 127.0.0.0/8 上。
  面板自身是 http 时才需要，https 走 A3 的本地 TLS 终止。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">127.0.0.2</domain>
        <domain includeSubdomains="false">127.0.0.3</domain>
        <domain includeSubdomains="false">127.0.0.4</domain>
        <domain includeSubdomains="false">127.0.0.5</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
